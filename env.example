# Copy to .env and change every CHANGE_ME.  Never commit .env.
# Generate random values with:  openssl rand -base64 32

# ── Project ──────────────────────────────────────────────
# Short, lowercase, no spaces. Names the containers and the network:
#   myproject-postgres, myproject-n8n, myproject-network ...
COMPOSE_PROJECT_NAME=myproject

# Your timezone (used by n8n schedules)
TIMEZONE=America/Denver

# ── Local ports (127.0.0.1 only) ─────────────────────────
# These are the vendor defaults; use them for your first stack.
# Each stack after that takes the next free number (5679, 5051, 8081...).
N8N_LOCAL_PORT=5678
PGADMIN_LOCAL_PORT=5050
WEB_LOCAL_PORT=8080

# ── Postgres ─────────────────────────────────────────────
POSTGRES_USER=myproject
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=myproject

# ── n8n ──────────────────────────────────────────────────
# Encrypts saved credentials. Copy it to your password manager.
# Lose it, and credentials in a restored database can't be decrypted.
N8N_ENCRYPTION_KEY=CHANGE_ME

# The public hostname n8n will use behind your tunnel.
N8N_HOST=n8n.example.com

# false while you only use it locally over http://127.0.0.1
# true once it's served over https through your tunnel
N8N_SECURE_COOKIE=false

# ── pgAdmin ──────────────────────────────────────────────
# Must look like a real email address; it's only a login name.
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME
